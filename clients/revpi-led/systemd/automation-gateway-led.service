[Unit]
Description=HomeAutomationMonitorGW RevPi status LED client
Documentation=https://github.com/tseiman/HomeAutomationMonitorGW/tree/main/clients/revpi-led
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=automation-gateway-led
Group=automation-gateway-led
SupplementaryGroups=picontrol
ExecStart=/usr/local/sbin/automation-gateway-led --config /etc/automation-gateway-led/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
UMask=0027

# The client needs HTTPS networking and only the piControl character device.
DevicePolicy=closed
DeviceAllow=/dev/piControl0 rw
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
